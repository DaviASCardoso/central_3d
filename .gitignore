# --- Resíduo do Bambu Studio ---
# O bambu-studio.exe grava result.json no diretório de trabalho corrente,
# inclusive quando invocado apenas com --help. A Central sempre o invoca com
# um cwd controlado, mas a rede de segurança fica aqui.
result.json

